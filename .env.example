# Local development only. Use a long password in /etc/daily-organiser.env on the house box.
# Do not point DATABASE_URL at 127.0.0.1:5432. Evolving Cook already listens there.
# Compose reaches Postgres as hostname "db" and does not publish a host port.
DATABASE_URL=postgresql+psycopg://organiser:organiser@db:5432/organiser
SEED_ON_START=true
HOUSE_TIMEZONE=Europe/London
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:8080
HOST=127.0.0.1
PORT=8080

# Mistral assistant. Leave either value empty to keep it off: then nothing is sent.
# Never commit these. On the house box they go in /etc/daily-organiser.env, and only
# after Cloudflare Access guards the hostname. See docs/mistral-agent.md.
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
# MISTRAL_MODEL=mistral-medium-latest
# MISTRAL_REASONING_EFFORT=high
# AGENT_RUNS_PER_DAY=12
# AGENT_PROACTIVE_PER_DAY=3
