# Local development only. Do not commit a filled-in copy.
# Secrets and the home location belong in the house environment file that
# discovery-system already uses. Do not create a second file.
# Do not point DATABASE_URL at 127.0.0.1:5432. Evolving Cook already listens there.
# Compose reaches Postgres as hostname "db" and does not publish a host port.
DATABASE_URL=postgresql+psycopg://organiser:organiser@db:5432/organiser
SEED_ON_START=true
HOUSE_TIMEZONE=Europe/London
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:8080
HOST=127.0.0.1
PORT=8080

# Leave both false on the house. Docs are served only when BOTH are true,
# and only then because Cloudflare Access already covers /docs, /redoc, and /openapi.json.
# This app does not check Access and will not publish a public docs URL.
ENABLE_DOCS=false
DOCS_BEHIND_ACCESS=false

# Mistral assistant. Leave either value empty to keep it off: then nothing is sent.
# Never commit these. discovery-system puts them in the existing house file,
# and only after Cloudflare Access guards the hostname. See docs/mistral-agent.md.
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
# MISTRAL_MODEL=mistral-medium-latest
# MISTRAL_REASONING_EFFORT=high
# AGENT_RUNS_PER_DAY=12
# AGENT_PROACTIVE_PER_DAY=3

# Home location. Leave every line empty in git.
# In the house file, set either both coordinates or a postcode. Never a real value here.
# When both coordinates are set they win; otherwise the postcode is the location.
# The app does not log these.
HOUSE_LAT=
HOUSE_LON=
HOUSE_POSTCODE=

# Diary, read-only. Not a calendar. Leave the secrets empty in git.
# Scopes to request on the personal account, once, with offline access:
#   https://www.googleapis.com/auth/calendar.events.readonly
#   https://www.googleapis.com/auth/calendar.calendarlist.readonly
# Do not request a write scope. Blank GOOGLE_CALENDAR_IDS means primary.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=

# Commute. Leave both empty in git.
# TFL_APP_KEY is a TfL Unified API key. BANTO_COMMUTE_TOKEN is the bearer for
# POST /commute/shift. The body is start, end, and location_label. Only the
# label Wembley is stored, and it means Wembley Park. The origin is the home
# location above. Do not put a real key, token, or postcode here.
# Optional burst limits for this process: RATE_FEED_PER_MINUTE (6),
# RATE_INGEST_PER_MINUTE (30), RATE_COMMUTE_PER_HOUR (12).
TFL_APP_KEY=
BANTO_COMMUTE_TOKEN=
