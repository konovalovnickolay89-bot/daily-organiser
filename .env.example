# Local development only. Use a long password in /etc/daily-organiser.env on the house box.
DATABASE_URL=postgresql+psycopg://organiser:organiser@localhost:5432/organiser
SEED_ON_START=true
HOUSE_TIMEZONE=Europe/London
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8000
