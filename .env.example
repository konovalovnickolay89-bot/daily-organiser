# Copy to .env and replace AUTH_SECRET before starting the app.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The server refuses the placeholder below.

# Shared home password. The login form checks this exact value.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional cookie signing key. When unset, AUTH_SECRET is used.
# Set a separate value if you want to change the password without
# immediately invalidating sessions (or the reverse).
# SESSION_SECRET=

SESSION_COOKIE_NAME=organiser_session
# Cookie lifetime in seconds. 1209600 = 14 days.
SESSION_MAX_AGE=1209600
# true only when every visit is HTTPS. Leave false for http on the LAN.
SESSION_HTTPS_ONLY=false

# SQLite file. Relative paths are from the repo root. The file is gitignored.
DATABASE_PATH=data/organiser.db

# 127.0.0.1 keeps the app on this machine.
# 0.0.0.0 also accepts connections from the home LAN.
HOST=127.0.0.1
PORT=8000
